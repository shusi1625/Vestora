generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingStatus {
  ACTIVE
  CANCELED
  SOLD
}

model SyncState {
  id                 String   @id @default("sepolia")
  chainId            Int      @map("chain_id")
  latestIndexedBlock BigInt   @default(0) @map("latest_indexed_block")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("sync_state")
}

model IndexedEvent {
  id              String   @id @default(cuid())
  chainId         Int      @map("chain_id")
  blockNumber     BigInt   @map("block_number")
  transactionHash String   @map("transaction_hash")
  logIndex        Int      @map("log_index")
  contractAddress String   @map("contract_address")
  eventName       String   @map("event_name")
  payload         Json?
  blockTimestamp  DateTime? @map("block_timestamp")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([transactionHash, logIndex])
  @@index([chainId, blockNumber])
  @@index([eventName])
  @@map("indexed_events")
}

model StreamEvent {
  id              String   @id @default(cuid())
  chainId         Int      @map("chain_id")
  contractAddress String   @map("contract_address")
  eventName       String   @map("event_name")
  blockNumber     BigInt   @map("block_number")
  blockHash       String   @map("block_hash")
  transactionHash String   @map("tx_hash")
  logIndex        Int      @map("log_index")
  streamId        BigInt?  @map("stream_id")
  payload         Json
  blockTimestamp  DateTime @map("block_timestamp")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([transactionHash, logIndex])
  @@index([chainId, blockNumber])
  @@index([eventName])
  @@index([streamId])
  @@map("stream_events")
}

model StreamProjection {
  streamId        BigInt    @id @map("stream_id")
  sender          String
  recipient       String
  currentOwner    String?   @map("current_owner")
  token           String
  depositedAmount String    @map("deposited_amount")
  withdrawnAmount String    @default("0") @map("withdrawn_amount")
  startTime       DateTime  @map("start_time")
  endTime         DateTime  @map("end_time")
  cancelable      Boolean
  canceledAt      DateTime? @map("canceled_at")
  createdTxHash   String    @map("created_tx_hash")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([sender])
  @@index([recipient])
  @@index([currentOwner])
  @@map("streams")
}

model ListingProjection {
  streamId      BigInt        @id @map("stream_id")
  seller        String
  price         String
  status        ListingStatus
  listedAt      DateTime      @map("listed_at")
  soldAt        DateTime?     @map("sold_at")
  canceledAt    DateTime?     @map("canceled_at")
  buyer         String?
  listingTxHash String        @map("listing_tx_hash")
  boughtTxHash  String?       @map("bought_tx_hash")
  canceledTxHash String?      @map("canceled_tx_hash")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([seller])
  @@index([buyer])
  @@index([status])
  @@map("listings")
}

model ClaimProjection {
  id              String   @id @default(cuid())
  streamId        BigInt   @map("stream_id")
  recipient       String
  amount          String
  claimedAt       DateTime @map("claimed_at")
  transactionHash String   @map("tx_hash")
  logIndex        Int      @map("log_index")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([transactionHash, logIndex])
  @@index([streamId])
  @@index([recipient])
  @@map("claims")
}

model TradeProjection {
  id              String   @id @default(cuid())
  streamId        BigInt   @map("stream_id")
  seller          String
  buyer           String
  price           String
  tradedAt        DateTime @map("traded_at")
  transactionHash String   @map("tx_hash")
  logIndex        Int      @map("log_index")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([transactionHash, logIndex])
  @@index([streamId])
  @@index([seller])
  @@index([buyer])
  @@map("trades")
}
